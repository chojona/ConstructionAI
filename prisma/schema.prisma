generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentRevisionStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum ExtractionRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED
}

/// V0 company roles. There is no entitlement, DSC, or change-order claimant role.
enum OrgRole {
  ORG_ADMIN
  REVIEWER
  CONTRIBUTOR
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Organization {
  id           String          @id @default(cuid())
  name         String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  projects     Project[]
  memberships  OrgMembership[]
}

/// A person. Each user has their own password hash. There is no shared product password.
model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String?
  passwordHash String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  memberships  OrgMembership[]
  sessions     Session[]
}

/// Membership of one person in one organization.
/// The unique pair allows a later multi-org consultant; invite still rejects a second org.
/// acceptTokenHash is set while status is INVITED and cleared on accept.
model OrgMembership {
  id                   String           @id @default(cuid())
  organizationId       String
  userId               String
  role                 OrgRole
  status               MembershipStatus @default(INVITED)
  acceptTokenHash      String?          @unique
  acceptTokenExpiresAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
}

/// Server-side session. The cookie holds the raw token; only the hash is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  projectNumber  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents             Document[]
  reviewDecisions       ReviewDecision[]
  exportPackets         ExportPacket[]
  exportPacketChapters  ExportPacketChapter[]
  emailSends            EmailSend[]
  heavyJobSourceObjects HeavyJobSourceObject[]

  @@index([organizationId, createdAt])
}

model Document {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  documentType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions DocumentRevision[]
  emailSends EmailSendDocument[]

  @@index([projectId, createdAt])
}

model DocumentRevision {
  id               String                 @id @default(cuid())
  documentId       String
  revisionLabel    String
  revisionOrder    Int
  originalFilename String
  mimeType         String
  byteSize         Int
  sha256           String
  storageKey       String
  status           DocumentRevisionStatus @default(UPLOADED)
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime               @default(now())

  document       Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  pages          DocumentPage[]
  extractionRuns ExtractionRun[]

  @@unique([documentId, revisionOrder])
  @@unique([documentId, revisionLabel])
  @@unique([documentId, sha256])
  @@index([documentId, createdAt])
}

model DocumentPage {
  id                 String   @id @default(cuid())
  documentRevisionId String
  pageNumber          Int
  text                String
  textSha256          String?
  createdAt           DateTime @default(now())

  documentRevision DocumentRevision @relation(fields: [documentRevisionId], references: [id], onDelete: Restrict)
  evidence         ProposedFactEvidence[]

  @@unique([documentRevisionId, pageNumber])
  @@index([documentRevisionId])
}

/// One immutable analysis attempt against a DocumentRevision.
/// ProposedFact rows attach here and cite DocumentPage ids.
/// Creating or advancing a run must not rewrite Project, Document, or DocumentRevision truth.
model ExtractionRun {
  id                 String              @id @default(cuid())
  documentRevisionId String
  attemptNumber      Int
  extractorName      String
  extractorVersion   String
  provider           String
  model              String
  status             ExtractionRunStatus @default(QUEUED)
  failureCode        String?
  failureMessage     String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())

  documentRevision DocumentRevision @relation(fields: [documentRevisionId], references: [id], onDelete: Restrict)
  proposedFacts    ProposedFact[]

  @@unique([documentRevisionId, attemptNumber])
  @@index([documentRevisionId, createdAt])
}

enum ProposedFactType {
  equipment_requirement
  schedule_date
  quantity
}

/// Immutable proposed extraction result. This is not canonical project state.
model ProposedFact {
  id              String           @id @default(cuid())
  extractionRunId String
  ordinal         Int
  factType        ProposedFactType
  payload         Json
  createdAt       DateTime         @default(now())

  extractionRun       ExtractionRun          @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
  evidence            ProposedFactEvidence[]
  reviewDecisions     ReviewDecision[]       @relation("DecisionSubject")
  decisionsAsBefore   ReviewDecision[]       @relation("DecisionBefore")
  decisionsAsAfter    ReviewDecision[]       @relation("DecisionAfter")

  @@unique([extractionRunId, ordinal])
  @@index([extractionRunId])
}

enum ReviewDecisionValue {
  ACCEPTED
  DISMISSED
  FLAGGED
}

enum ReviewSubjectKind {
  PROPOSED_FACT
  REVISION_CHANGE
}

enum RevisionChangeType {
  ADDED
  REMOVED
  MODIFIED
}

/// Append-only human decision. Later decisions supersede earlier ones by link;
/// source revisions, extraction runs, and proposed facts stay immutable.
model ReviewDecision {
  id                   String              @id @default(cuid())
  projectId            String
  subjectKind          ReviewSubjectKind
  subjectKey           String
  decision             ReviewDecisionValue
  reviewerId           String
  reason               String?
  proposedFactId       String
  beforeProposedFactId String?
  afterProposedFactId  String?
  baseRevisionId       String?
  revisedRevisionId    String?
  changeType           RevisionChangeType?
  supersedesDecisionId String?             @unique
  createdAt            DateTime            @default(now())

  project            Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  proposedFact       ProposedFact    @relation("DecisionSubject", fields: [proposedFactId], references: [id], onDelete: Restrict)
  beforeProposedFact ProposedFact?   @relation("DecisionBefore", fields: [beforeProposedFactId], references: [id], onDelete: Restrict)
  afterProposedFact  ProposedFact?   @relation("DecisionAfter", fields: [afterProposedFactId], references: [id], onDelete: Restrict)
  supersedes         ReviewDecision?        @relation("ReviewSupersession", fields: [supersedesDecisionId], references: [id], onDelete: Restrict)
  supersededBy       ReviewDecision?        @relation("ReviewSupersession")
  exportPackets        ExportPacketDecision[]
  exportPacketChapters ExportPacketChapterDecision[]
  emailSends           EmailSendDecision[]

  @@index([projectId, subjectKey, createdAt])
  @@index([projectId, createdAt])
  @@index([proposedFactId])
}

/// Exact page evidence. Offsets distinguish repeated excerpts on one page.
model ProposedFactEvidence {
  id             String @id @default(cuid())
  proposedFactId String
  documentPageId String
  ordinal        Int
  pageNumber     Int
  excerpt        String
  startOffset    Int
  endOffset      Int

  proposedFact ProposedFact @relation(fields: [proposedFactId], references: [id], onDelete: Restrict)
  documentPage DocumentPage @relation(fields: [documentPageId], references: [id], onDelete: Restrict)

  @@unique([proposedFactId, ordinal])
  @@index([documentPageId])
}

/// Frozen approved-change packet.
/// contentHash is the sha256 of the canonical JSON: approved changes, decision ids,
/// chapters, and appendices. Each chapter or appendix file is included by its own sha256.
/// Bytes live in object storage at storageKey. payload is only the legacy
/// database copy until `npm run storage:migrate-packets` clears it.
/// Decisions linked here are ACCEPTED review decisions only.
/// A later chapter or appendix attach stores a new packet. It does not rewrite this hash.
model ExportPacket {
  id          String   @id @default(cuid())
  projectId   String
  contentHash String
  storageKey  String   @unique
  payload     Bytes?
  byteSize    Int
  createdAt   DateTime @default(now())

  project    Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  decisions  ExportPacketDecision[]
  emailSends EmailSend[]

  @@unique([projectId, contentHash])
  @@index([projectId, createdAt])
}

model ExportPacketDecision {
  exportPacketId   String
  reviewDecisionId String
  ordinal          Int

  exportPacket   ExportPacket   @relation(fields: [exportPacketId], references: [id], onDelete: Restrict)
  reviewDecision ReviewDecision @relation(fields: [reviewDecisionId], references: [id], onDelete: Restrict)

  @@id([exportPacketId, reviewDecisionId])
  @@unique([exportPacketId, ordinal])
  @@index([reviewDecisionId])
}

/// Supporting file on an approved pack.
/// role is an ACC Docs chapter, an RFI PDF chapter, or a Bluebeam Markup Summary appendix.
/// Raw bytes live in the private object store at storageKey.
/// Identity is the sha256 (contentHash) of those bytes, scoped to the project and role.
/// A second attach of the same bytes returns this row. sourceId and fetchedAt stay from the first write.
/// sourceId, fetchedAt, and contentHash are the provenance.
/// pageCites is the markup-summary page inventory. Each entry is a JSON pin of
/// DocumentRevision id, revision label, page, and content hash when bytes are stored.
/// A bare page number is not a cite. Rows left as bare page strings ("2", "C-101")
/// are legacy: the desk asks to re-attach, and scripts/migrate-legacy-page-cites.ts
/// can pin them. Other roles leave it empty.
/// Linked decisions are ACCEPTED review decisions only. This extends ExportPacket.
model ExportPacketChapter {
  id          String   @id @default(cuid())
  projectId   String
  role        String
  title       String
  sourceId    String
  fetchedAt   DateTime
  contentHash String
  storageKey  String
  filename    String
  byteSize    Int
  pageCites   String[] @default([])
  createdAt   DateTime @default(now())

  project   Project                        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  decisions ExportPacketChapterDecision[]

  @@unique([projectId, contentHash, role])
  @@index([projectId, fetchedAt])
}

model ExportPacketChapterDecision {
  chapterId        String
  reviewDecisionId String
  ordinal          Int

  chapter        ExportPacketChapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  reviewDecision ReviewDecision       @relation(fields: [reviewDecisionId], references: [id], onDelete: Restrict)

  @@id([chapterId, reviewDecisionId])
  @@unique([chapterId, ordinal])
  @@index([reviewDecisionId])
}

enum EmailSendStatus {
  DRAFT
  SENT
}

/// Human email ledger for one approved pack. Send records intent only.
/// actorId is the User id when the request names a person, otherwise the demo desk's free-text name.
/// No mail transport is attached.
model EmailSend {
  id             String          @id @default(cuid())
  projectId      String
  exportPacketId String
  status         EmailSendStatus
  recipients     String[]
  subject        String
  body           String
  actorId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime
  sentAt         DateTime?

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  exportPacket ExportPacket        @relation(fields: [exportPacketId], references: [id], onDelete: Restrict)
  decisions    EmailSendDecision[]
  documents    EmailSendDocument[]

  @@index([projectId, createdAt])
  @@index([projectId, exportPacketId, status])
  @@index([exportPacketId])
}

model EmailSendDecision {
  emailSendId      String
  reviewDecisionId String
  ordinal          Int

  emailSend      EmailSend      @relation(fields: [emailSendId], references: [id], onDelete: Restrict)
  reviewDecision ReviewDecision @relation(fields: [reviewDecisionId], references: [id], onDelete: Restrict)

  @@id([emailSendId, reviewDecisionId])
  @@unique([emailSendId, ordinal])
  @@index([reviewDecisionId])
}

model EmailSendDocument {
  emailSendId String
  documentId  String
  ordinal     Int

  emailSend EmailSend @relation(fields: [emailSendId], references: [id], onDelete: Restrict)
  document  Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@id([emailSendId, documentId])
  @@unique([emailSendId, ordinal])
  @@index([documentId])
}

enum HeavyJobObjectType {
  timecard
  cost_code
  quantity
  diary
  attachment
}

/// Immutable HeavyJob fetch snapshot for one Project.
/// raw is the external payload. Timecard isTm / isRework flags stay inside raw as data.
/// This table does not classify entitlements, and inserting a row must not rewrite
/// Project, Document, or DocumentRevision truth.
model HeavyJobSourceObject {
  id         String             @id @default(cuid())
  projectId  String
  objectType HeavyJobObjectType
  sourceId   String
  fetchedAt  DateTime
  raw        Json
  createdAt  DateTime           @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, objectType, sourceId, fetchedAt])
  @@index([projectId, objectType, fetchedAt])
}
