generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentRevisionStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum ExtractionRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  projectNumber  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents    Document[]

  @@index([organizationId, createdAt])
}

model Document {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  documentType String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions DocumentRevision[]

  @@index([projectId, createdAt])
}

model DocumentRevision {
  id               String                 @id @default(cuid())
  documentId       String
  revisionLabel    String
  revisionOrder    Int
  originalFilename String
  mimeType         String
  byteSize         Int
  sha256           String
  storageKey       String
  status           DocumentRevisionStatus @default(UPLOADED)
  failureCode      String?
  failureMessage   String?
  createdAt        DateTime               @default(now())

  document       Document        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  pages          DocumentPage[]
  extractionRuns ExtractionRun[]

  @@unique([documentId, revisionOrder])
  @@unique([documentId, revisionLabel])
  @@unique([documentId, sha256])
  @@index([documentId, createdAt])
}

model DocumentPage {
  id                 String   @id @default(cuid())
  documentRevisionId String
  pageNumber          Int
  text                String
  textSha256          String?
  createdAt           DateTime @default(now())

  documentRevision DocumentRevision @relation(fields: [documentRevisionId], references: [id], onDelete: Restrict)
  evidence         ProposedFactEvidence[]

  @@unique([documentRevisionId, pageNumber])
  @@index([documentRevisionId])
}

/// One immutable analysis attempt against a DocumentRevision.
/// ProposedFact rows attach here and cite DocumentPage ids.
/// Creating or advancing a run must not rewrite Project, Document, or DocumentRevision truth.
model ExtractionRun {
  id                 String              @id @default(cuid())
  documentRevisionId String
  attemptNumber      Int
  extractorName      String
  extractorVersion   String
  provider           String
  model              String
  status             ExtractionRunStatus @default(QUEUED)
  failureCode        String?
  failureMessage     String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())

  documentRevision DocumentRevision @relation(fields: [documentRevisionId], references: [id], onDelete: Restrict)
  proposedFacts    ProposedFact[]

  @@unique([documentRevisionId, attemptNumber])
  @@index([documentRevisionId, createdAt])
}

enum ProposedFactType {
  equipment_requirement
  schedule_date
  quantity
}

/// Immutable proposed extraction result. This is not canonical project state.
model ProposedFact {
  id              String           @id @default(cuid())
  extractionRunId String
  ordinal         Int
  factType        ProposedFactType
  payload         Json
  createdAt       DateTime         @default(now())

  extractionRun ExtractionRun          @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
  evidence      ProposedFactEvidence[]

  @@unique([extractionRunId, ordinal])
  @@index([extractionRunId])
}

/// Exact page evidence. Offsets distinguish repeated excerpts on one page.
model ProposedFactEvidence {
  id             String @id @default(cuid())
  proposedFactId String
  documentPageId String
  ordinal        Int
  pageNumber     Int
  excerpt        String
  startOffset    Int
  endOffset      Int

  proposedFact ProposedFact @relation(fields: [proposedFactId], references: [id], onDelete: Restrict)
  documentPage DocumentPage @relation(fields: [documentPageId], references: [id], onDelete: Restrict)

  @@unique([proposedFactId, ordinal])
  @@index([documentPageId])
}
