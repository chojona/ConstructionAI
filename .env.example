# Neon PostgreSQL
# Use the pooled Neon connection string for application/runtime traffic.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-STAGING-POOLER.neon.tech/YOUR_DB?sslmode=require"

# Use the direct (non-pooled) Neon connection string for Prisma migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@YOUR-STAGING.neon.tech/YOUR_DB?sslmode=require"

APP_ORGANIZATION_ID="org_demo"
DOCUMENT_STORAGE_DIR="./data/documents"
DOCUMENT_MAX_BYTES="20971520"

# S3-compatible object storage for approved pack bytes and document files.
# Leave the bucket and keys empty for local demos; bytes stay under DOCUMENT_STORAGE_DIR.
# Production on Vercel uses the Neon names below. OBJECT_STORAGE_* overrides them when set.
# Set the bucket and both keys together on Vercel (or any host with a temporary filesystem).
DOCUMENT_STORAGE_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL_S3=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_FORCE_PATH_STYLE=""

OPENAI_API_KEY=""

# Structured construction-fact extraction
OPENAI_EXTRACTION_MODEL="gpt-6.1-sol"

# Optional high-volume triage and difficult-case escalation
OPENAI_BULK_MODEL="gpt-6-luna"
OPENAI_ESCALATION_MODEL="gpt-6-astra"

# Image and drawing analysis
OPENAI_VISION_MODEL="gpt-6.1-sol"

# Semantic document search
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"