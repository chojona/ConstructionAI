# Neon PostgreSQL
# Use the pooled Neon connection string for application/runtime traffic.
# Preview on Vercel must use its own Neon branch for DATABASE_URL and
# DIRECT_DATABASE_URL. Do not point Preview at the production database.
# Migrations run only when VERCEL_ENV=production.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-STAGING-POOLER.neon.tech/YOUR_DB?sslmode=require"

# Use the direct (non-pooled) Neon connection string for Prisma migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@YOUR-STAGING.neon.tech/YOUR_DB?sslmode=require"

# npm run db:seed is manual. It refuses when VERCEL_ENV or NODE_ENV is
# production unless this is exactly 1.
ALLOW_PROD_SEED=""

APP_ORGANIZATION_ID="org_demo"
# Seed adds an active org admin user_demo (alex.chen@northstar.example) in that organization.
# Set a password of at least 10 characters to sign in as that person at /login.
# Leave it empty to skip storing a password. Invited people set their own on accept.
DEMO_USER_PASSWORD=""
# Temporary test and local-script switch. "1" lets API routes trust x-user-id.
# Leave unset for real use. A request with no session cookie is rejected.
# The process refuses to start when this is 1, true, or yes and VERCEL_ENV=production.
AUTH_TRUST_USER_HEADER=""
DOCUMENT_STORAGE_DIR="./data/documents"
# Ignored above 4400000. Vercel rejects function bodies over 4.5 MB before our code runs.
DOCUMENT_MAX_BYTES="4400000"

# S3-compatible object storage for approved pack bytes and document files.
# Leave the bucket and keys empty for local demos; bytes stay under DOCUMENT_STORAGE_DIR.
# Production on Vercel uses the Neon names below. OBJECT_STORAGE_* overrides them when set.
# Set the bucket and both keys together on Vercel (or any host with a temporary filesystem).
DOCUMENT_STORAGE_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL_S3=""
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_FORCE_PATH_STYLE=""

OPENAI_API_KEY=""

# Structured construction-fact extraction
OPENAI_EXTRACTION_MODEL="gpt-6.1-sol"

# Optional high-volume triage and difficult-case escalation
OPENAI_BULK_MODEL="gpt-6-luna"
OPENAI_ESCALATION_MODEL="gpt-6-astra"

# Image and drawing analysis
OPENAI_VISION_MODEL="gpt-6.1-sol"

# Semantic document search
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Legal pages. Only the exact value true publishes /privacy, /terms, the footer
# links, the signup consent block, and the card B pilot label. Any other value
# leaves those routes 404 and omits the links. Publishing also requires every
# legal fact below. If the flag is true and any fact is empty, the server logs
# one warning, the routes stay 404, and startup and next build both fail.
LEGAL_PAGES_PUBLISHED=""
LEGAL_ENTITY_NAME=""
LEGAL_POSTAL_ADDRESS=""
LEGAL_PRIVACY_EMAIL=""
LEGAL_SUPPORT_EMAIL=""
LEGAL_CONTACT_EMAIL=""
LEGAL_EFFECTIVE_DATE=""
LEGAL_STORAGE_PROVIDER=""
LEGAL_STORAGE_PROVIDER_DETAIL=""
LEGAL_COPYRIGHT_YEAR=""
LEGAL_WARRANTY_DISCLAIMER=""